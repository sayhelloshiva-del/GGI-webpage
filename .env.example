# ---------------------------------------------------------------------------
# AI TRACK MATCHER
# ---------------------------------------------------------------------------
# The Track Matcher calls the Claude API to explain a delegate's track match.
#
# THE SITE IS FULLY FUNCTIONAL WITHOUT THIS KEY.
# When the key is absent (or the provider fails, times out or returns
# malformed JSON) the matcher falls back to the deterministic scoring engine
# in lib/track-scoring.ts and tells the user it has done so.
#
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# Optional. Milliseconds before the server abandons the model call and
# returns a locally-scored result instead. Defaults to 9000.
TRACK_MATCH_TIMEOUT_MS=9000

# Optional. Public URL used for metadata / Open Graph tags.
NEXT_PUBLIC_SITE_URL=
